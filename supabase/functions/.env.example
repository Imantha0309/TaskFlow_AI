# ---------------------------------------------------------------------------
# Local Edge Function secrets
#
# Copy to `supabase/functions/.env` and fill in the values. This file is only
# used by `supabase functions serve --env-file ./supabase/functions/.env`.
#
# In production set the same values as function secrets:
#   supabase secrets set SUPABASE_URL=... SUPABASE_ANON_KEY=... \
#     SUPABASE_SERVICE_ROLE_KEY=... ALLOWED_ORIGIN=https://your-app.vercel.app
#
# The service_role key must never be sent to the browser or committed.
# ---------------------------------------------------------------------------

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional CORS allowlist. Leave empty for local development (wildcard).
ALLOWED_ORIGIN=
