# ---------------------------------------------------------------------------
# TaskFlow AI — frontend environment variables
#
# 1. Copy this file to `frontend/.env` (same folder) — never commit `.env`.
# 2. Fill in the values from your Supabase project dashboard:
#    Project Settings -> API (or Project Settings -> API Keys for new projects).
# 3. Restart the dev server after changing values; Vite only reads env at boot.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Everything in the browser is public: protect data with Row Level Security.
#
# NEVER put the service_role key (or any secret) in a VITE_ variable.
# Service-role operations belong in Supabase Edge Functions, where the key is
# read from server-side secrets (see supabase/functions/README.md).
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
